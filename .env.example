BRAIN_DIR=./volumes/brain

# LiteLLM Master Key (Change this in production)
LITELLM_MASTER_KEY=sk-1234-5678-admin

# Embedding Configuration
# Providers: ollama, openai, litellm
ANTHROPIC_API_KEY=sk-ant-api03-***
OPENAI_API_KEY=sk-proj-***


# Ollama API URL (Default: Host machine)
# If running with 'ollama' profile, you might want to point this to the container:
OLLAMA_API_BASE=http://host.docker.internal:11434 

# Context Driver Configuration
CONTEXT_DRIVER_EMBEDDING_CONFIGURATION=ollama-nomic
CONTEXT_DRIVER_SEARCH_STRATEGY=super_hybrid

# Debugging: Log actual prompts sent to LiteLLM (true/false)
# WARNING: May contain sensitive information - disable in production
CONTEXT_DRIVER_LOG_PROMPTS=false


JIRA_API_TOKEN=your_jira_api_token_here
JIRA_EMAIL=your_email_here