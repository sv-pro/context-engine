BRAIN_DIR=./volumes/brain

# LiteLLM Master Key (Change this in production)
LITELLM_MASTER_KEY=sk-1234-5678-admin

# Embedding Configuration
# Providers: ollama, openai, litellm
ANTHROPIC_API_KEY=sk-ant-api03-***
OPENAI_API_KEY=sk-proj-***


# Ollama API URL (Default: Host machine)
# If running with 'ollama' profile, you might want to point this to the container:
OLLAMA_API_BASE=http://host.docker.internal:11434 

EMBEDDING_CONFIGURATION=ollama-nomic
