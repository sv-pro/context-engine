{"openapi":"3.1.0","info":{"title":"Brain Knowledge Base Tools","description":"\nKnowledge Base tools for AI assistants.\n\nThese tools allow AI models to search and retrieve information from a local \nknowledge base of markdown documents.\n\n**Available Tools:**\n- **search**: Find relevant documents using semantic/hybrid search\n- **get_article**: Retrieve full article content\n- **list_articles**: Browse available articles\n- **get_related**: Find related documents via wikilinks\n","version":"1.0.0"},"paths":{"/tools/search":{"post":{"tags":["Knowledge Base Tools"],"summary":"Search Knowledge Base","description":"Search the knowledge base using semantic similarity, keyword matching, or hybrid strategies.\n\nThis tool finds relevant documents and content chunks that match your query.\nUse it when you need to find information about a specific topic.\n\n**Strategies:**\n- `semantic`: Pure vector similarity search\n- `keyword`: Full-text search with PostgreSQL\n- `hybrid`: Combines semantic and keyword scores\n- `super_hybrid`: Best quality - combines semantic, keyword, and graph traversal\n- `graph`: Follow wikilinks between related documents","operationId":"search_knowledge_base_tools_search_post","requestBody":{"required":true,"content":{"application/json":{"schema":{"$ref":"#/components/schemas/SearchRequest"}}}},"responses":{"200":{"description":"Successful Response","content":{"application/json":{"schema":{"$ref":"#/components/schemas/SearchResponse"}}}},"422":{"description":"Validation Error","content":{"application/json":{"schema":{"$ref":"#/components/schemas/HTTPValidationError"}}}}}},"get":{"tags":["Knowledge Base Tools"],"summary":"Search Knowledge Base (GET)","description":"GET version of search for simple queries. Use POST for more control.","operationId":"search_knowledge_base_get_tools_search_get","parameters":[{"name":"query","in":"query","required":true,"schema":{"type":"string","description":"Natural language search query","title":"Query"},"description":"Natural language search query"},{"name":"limit","in":"query","required":false,"schema":{"type":"integer","maximum":20,"minimum":1,"description":"Maximum number of results","default":5,"title":"Limit"},"description":"Maximum number of results"},{"name":"strategy","in":"query","required":false,"schema":{"type":"string","description":"Search strategy","default":"super_hybrid","title":"Strategy"},"description":"Search strategy"}],"responses":{"200":{"description":"Successful Response","content":{"application/json":{"schema":{"$ref":"#/components/schemas/SearchResponse"}}}},"422":{"description":"Validation Error","content":{"application/json":{"schema":{"$ref":"#/components/schemas/HTTPValidationError"}}}}}}},"/tools/article/{title_or_path}":{"get":{"tags":["Knowledge Base Tools"],"summary":"Get Full Article","description":"Retrieve the complete content of a specific article by its title or file path.\n\nUse this when you need the full context of a document, not just a snippet.","operationId":"get_article_tools_article__title_or_path__get","parameters":[{"name":"title_or_path","in":"path","required":true,"schema":{"type":"string","title":"Title Or Path"}}],"responses":{"200":{"description":"Successful Response","content":{"application/json":{"schema":{"$ref":"#/components/schemas/ArticleResponse"}}}},"422":{"description":"Validation Error","content":{"application/json":{"schema":{"$ref":"#/components/schemas/HTTPValidationError"}}}}}}},"/tools/articles":{"get":{"tags":["Knowledge Base Tools"],"summary":"List All Articles","description":"List all available articles in the knowledge base.\n\nOptionally filter by title text. Use this to discover what topics are available.","operationId":"list_articles_tools_articles_get","parameters":[{"name":"filter","in":"query","required":false,"schema":{"anyOf":[{"type":"string"},{"type":"null"}],"description":"Filter articles by title (case-insensitive)","title":"Filter"},"description":"Filter articles by title (case-insensitive)"}],"responses":{"200":{"description":"Successful Response","content":{"application/json":{"schema":{"$ref":"#/components/schemas/ArticleListResponse"}}}},"422":{"description":"Validation Error","content":{"application/json":{"schema":{"$ref":"#/components/schemas/HTTPValidationError"}}}}}}},"/tools/related/{title_or_path}":{"get":{"tags":["Knowledge Base Tools"],"summary":"Get Related Articles","description":"Find articles related to a specific document via wikilinks.\n\nReturns both outgoing links (documents this article references) and \nincoming links (documents that reference this article).","operationId":"get_related_articles_tools_related__title_or_path__get","parameters":[{"name":"title_or_path","in":"path","required":true,"schema":{"type":"string","title":"Title Or Path"}}],"responses":{"200":{"description":"Successful Response","content":{"application/json":{"schema":{"$ref":"#/components/schemas/RelatedArticlesResponse"}}}},"422":{"description":"Validation Error","content":{"application/json":{"schema":{"$ref":"#/components/schemas/HTTPValidationError"}}}}}}},"/tools/facts":{"get":{"tags":["Knowledge Base Tools"],"summary":"List Extracted Facts","description":"Query extracted subject-predicate-object facts from the knowledge base.\n\nFacts are automatically extracted from documents during ingestion using DSPy.\nUse filters to narrow results by subject, predicate, or source document.","operationId":"list_facts_tools_facts_get","parameters":[{"name":"subject","in":"query","required":false,"schema":{"anyOf":[{"type":"string"},{"type":"null"}],"description":"Filter by subject (partial match)","title":"Subject"},"description":"Filter by subject (partial match)"},{"name":"predicate","in":"query","required":false,"schema":{"anyOf":[{"type":"string"},{"type":"null"}],"description":"Filter by predicate (partial match)","title":"Predicate"},"description":"Filter by predicate (partial match)"},{"name":"source_id","in":"query","required":false,"schema":{"anyOf":[{"type":"integer"},{"type":"null"}],"description":"Filter by source note ID","title":"Source Id"},"description":"Filter by source note ID"},{"name":"limit","in":"query","required":false,"schema":{"type":"integer","maximum":200,"minimum":1,"description":"Maximum results","default":50,"title":"Limit"},"description":"Maximum results"}],"responses":{"200":{"description":"Successful Response","content":{"application/json":{"schema":{"$ref":"#/components/schemas/FactListResponse"}}}},"422":{"description":"Validation Error","content":{"application/json":{"schema":{"$ref":"#/components/schemas/HTTPValidationError"}}}}}}},"/tools/rules":{"get":{"tags":["Knowledge Base Tools"],"summary":"List Extracted Rules","description":"Query extracted IF-THEN rules from procedural documents.\n\nRules are automatically extracted from procedures, policies, and incident reports.\nUse filters to find rules by severity or source document.","operationId":"list_rules_tools_rules_get","parameters":[{"name":"severity","in":"query","required":false,"schema":{"anyOf":[{"type":"string"},{"type":"null"}],"description":"Filter by severity: critical, high, normal, low","title":"Severity"},"description":"Filter by severity: critical, high, normal, low"},{"name":"source_id","in":"query","required":false,"schema":{"anyOf":[{"type":"integer"},{"type":"null"}],"description":"Filter by source note ID","title":"Source Id"},"description":"Filter by source note ID"},{"name":"limit","in":"query","required":false,"schema":{"type":"integer","maximum":200,"minimum":1,"description":"Maximum results","default":50,"title":"Limit"},"description":"Maximum results"}],"responses":{"200":{"description":"Successful Response","content":{"application/json":{"schema":{"$ref":"#/components/schemas/RuleListResponse"}}}},"422":{"description":"Validation Error","content":{"application/json":{"schema":{"$ref":"#/components/schemas/HTTPValidationError"}}}}}}},"/tools/capsules":{"get":{"tags":["Knowledge Base Tools"],"summary":"List Document Capsules","description":"Query condensed document summaries (capsules) from the knowledge base.\n\nCapsules contain summary, key points, intent, and domain for each document.\nUse filters to find documents by domain or intent type.","operationId":"list_capsules_tools_capsules_get","parameters":[{"name":"domain","in":"query","required":false,"schema":{"anyOf":[{"type":"string"},{"type":"null"}],"description":"Filter by domain: ssl, networking, auth, etc.","title":"Domain"},"description":"Filter by domain: ssl, networking, auth, etc."},{"name":"intent","in":"query","required":false,"schema":{"anyOf":[{"type":"string"},{"type":"null"}],"description":"Filter by intent: procedure, fact, policy, incident, reference","title":"Intent"},"description":"Filter by intent: procedure, fact, policy, incident, reference"},{"name":"limit","in":"query","required":false,"schema":{"type":"integer","maximum":200,"minimum":1,"description":"Maximum results","default":50,"title":"Limit"},"description":"Maximum results"}],"responses":{"200":{"description":"Successful Response","content":{"application/json":{"schema":{"$ref":"#/components/schemas/CapsuleListResponse"}}}},"422":{"description":"Validation Error","content":{"application/json":{"schema":{"$ref":"#/components/schemas/HTTPValidationError"}}}}}}},"/tools/capsule/{note_id}":{"get":{"tags":["Knowledge Base Tools"],"summary":"Get Capsule for Note","description":"Get the condensed capsule for a specific note by its ID.","operationId":"get_capsule_tools_capsule__note_id__get","parameters":[{"name":"note_id","in":"path","required":true,"schema":{"type":"integer","title":"Note Id"}}],"responses":{"200":{"description":"Successful Response","content":{"application/json":{"schema":{"$ref":"#/components/schemas/CapsuleItem"}}}},"422":{"description":"Validation Error","content":{"application/json":{"schema":{"$ref":"#/components/schemas/HTTPValidationError"}}}}}}}},"components":{"schemas":{"ArticleListItem":{"properties":{"title":{"type":"string","title":"Title","description":"Article title"},"file_path":{"type":"string","title":"File Path","description":"Source file path"}},"type":"object","required":["title","file_path"],"title":"ArticleListItem","description":"Summary of an article for listing."},"ArticleListResponse":{"properties":{"filter":{"anyOf":[{"type":"string"},{"type":"null"}],"title":"Filter","description":"Filter applied"},"articles":{"items":{"$ref":"#/components/schemas/ArticleListItem"},"type":"array","title":"Articles","description":"List of articles"},"total":{"type":"integer","title":"Total","description":"Total number of articles"}},"type":"object","required":["articles","total"],"title":"ArticleListResponse","description":"Response containing list of articles."},"ArticleResponse":{"properties":{"title":{"type":"string","title":"Title","description":"Article title"},"file_path":{"type":"string","title":"File Path","description":"Source file path"},"keywords":{"items":{"type":"string"},"type":"array","title":"Keywords","description":"Semantic keywords"},"content":{"type":"string","title":"Content","description":"Full article content in markdown"}},"type":"object","required":["title","file_path","content"],"title":"ArticleResponse","description":"Full article content."},"CapsuleItem":{"properties":{"id":{"type":"integer","title":"Id","description":"Unique capsule ID"},"summary":{"type":"string","title":"Summary","description":"2-3 sentence summary"},"key_points":{"items":{"type":"string"},"type":"array","title":"Key Points","description":"Key bullet points"},"intent":{"type":"string","title":"Intent","description":"Document intent: procedure, fact, policy, incident, reference"},"domain":{"type":"string","title":"Domain","description":"Primary domain: ssl, networking, auth, etc."},"confidence":{"type":"number","title":"Confidence","description":"Extraction confidence (0-1)"},"source_id":{"type":"integer","title":"Source Id","description":"Source note ID"},"source_title":{"type":"string","title":"Source Title","description":"Source note title"},"source_path":{"type":"string","title":"Source Path","description":"Source file path"}},"type":"object","required":["id","summary","intent","domain","confidence","source_id","source_title","source_path"],"title":"CapsuleItem","description":"A condensed document capsule with summary and metadata."},"CapsuleListResponse":{"properties":{"capsules":{"items":{"$ref":"#/components/schemas/CapsuleItem"},"type":"array","title":"Capsules","description":"List of document capsules"},"total":{"type":"integer","title":"Total","description":"Number of capsules returned"},"filters":{"additionalProperties":true,"type":"object","title":"Filters","description":"Applied filters"}},"type":"object","required":["capsules","total"],"title":"CapsuleListResponse","description":"Response containing list of capsules."},"FactItem":{"properties":{"id":{"type":"integer","title":"Id","description":"Unique fact ID"},"subject":{"type":"string","title":"Subject","description":"Subject of the fact"},"predicate":{"type":"string","title":"Predicate","description":"Relationship or action"},"object":{"type":"string","title":"Object","description":"Object of the fact"},"provenance":{"anyOf":[{"type":"string"},{"type":"null"}],"title":"Provenance","description":"Source reference"},"confidence":{"type":"number","title":"Confidence","description":"Extraction confidence (0-1)"},"source_id":{"type":"integer","title":"Source Id","description":"Source note ID"},"source_title":{"type":"string","title":"Source Title","description":"Source note title"}},"type":"object","required":["id","subject","predicate","object","confidence","source_id","source_title"],"title":"FactItem","description":"A single extracted fact (subject-predicate-object triple)."},"FactListResponse":{"properties":{"facts":{"items":{"$ref":"#/components/schemas/FactItem"},"type":"array","title":"Facts","description":"List of extracted facts"},"total":{"type":"integer","title":"Total","description":"Number of facts returned"},"filters":{"additionalProperties":true,"type":"object","title":"Filters","description":"Applied filters"}},"type":"object","required":["facts","total"],"title":"FactListResponse","description":"Response containing list of facts."},"HTTPValidationError":{"properties":{"detail":{"items":{"$ref":"#/components/schemas/ValidationError"},"type":"array","title":"Detail"}},"type":"object","title":"HTTPValidationError"},"RelatedArticlesResponse":{"properties":{"source_title":{"type":"string","title":"Source Title","description":"Title of the source article"},"outgoing_links":{"items":{"type":"string"},"type":"array","title":"Outgoing Links","description":"Articles this document links to"},"incoming_links":{"items":{"type":"string"},"type":"array","title":"Incoming Links","description":"Articles that link to this document"}},"type":"object","required":["source_title"],"title":"RelatedArticlesResponse","description":"Response containing related articles."},"RuleItem":{"properties":{"id":{"type":"integer","title":"Id","description":"Unique rule ID"},"rule_id":{"anyOf":[{"type":"string"},{"type":"null"}],"title":"Rule Id","description":"Human-readable rule identifier"},"condition":{"type":"string","title":"Condition","description":"IF condition"},"action":{"type":"string","title":"Action","description":"THEN action"},"severity":{"type":"string","title":"Severity","description":"Rule severity: critical, high, normal, low"},"provenance":{"anyOf":[{"type":"string"},{"type":"null"}],"title":"Provenance","description":"Source reference"},"source_id":{"type":"integer","title":"Source Id","description":"Source note ID"},"source_title":{"type":"string","title":"Source Title","description":"Source note title"}},"type":"object","required":["id","condition","action","severity","source_id","source_title"],"title":"RuleItem","description":"A single extracted rule (IF-THEN logic)."},"RuleListResponse":{"properties":{"rules":{"items":{"$ref":"#/components/schemas/RuleItem"},"type":"array","title":"Rules","description":"List of extracted rules"},"total":{"type":"integer","title":"Total","description":"Number of rules returned"},"filters":{"additionalProperties":true,"type":"object","title":"Filters","description":"Applied filters"}},"type":"object","required":["rules","total"],"title":"RuleListResponse","description":"Response containing list of rules."},"SearchRequest":{"properties":{"query":{"type":"string","title":"Query","description":"Natural language search query"},"limit":{"type":"integer","maximum":20.0,"minimum":1.0,"title":"Limit","description":"Maximum number of results to return","default":5},"strategy":{"type":"string","title":"Strategy","description":"Search strategy: semantic, keyword, hybrid, super_hybrid, graph","default":"super_hybrid"}},"type":"object","required":["query"],"title":"SearchRequest","description":"Request model for knowledge base search."},"SearchResponse":{"properties":{"query":{"type":"string","title":"Query","description":"Original search query"},"strategy":{"type":"string","title":"Strategy","description":"Search strategy used"},"results":{"items":{"$ref":"#/components/schemas/SearchResult"},"type":"array","title":"Results","description":"List of search results"},"total_results":{"type":"integer","title":"Total Results","description":"Number of results returned"}},"type":"object","required":["query","strategy","results","total_results"],"title":"SearchResponse","description":"Response containing search results."},"SearchResult":{"properties":{"rank":{"type":"integer","title":"Rank","description":"Result ranking (1 = most relevant)"},"title":{"type":"string","title":"Title","description":"Document title"},"section":{"anyOf":[{"type":"string"},{"type":"null"}],"title":"Section","description":"Section within the document"},"file_path":{"type":"string","title":"File Path","description":"Source file path"},"similarity":{"type":"number","title":"Similarity","description":"Similarity score (0-1)"},"content":{"type":"string","title":"Content","description":"Relevant content snippet"}},"type":"object","required":["rank","title","file_path","similarity","content"],"title":"SearchResult","description":"A single search result from the knowledge base."},"ValidationError":{"properties":{"loc":{"items":{"anyOf":[{"type":"string"},{"type":"integer"}]},"type":"array","title":"Location"},"msg":{"type":"string","title":"Message"},"type":{"type":"string","title":"Error Type"}},"type":"object","required":["loc","msg","type"],"title":"ValidationError"}}},"servers":[{"url":"http://5.75.148.68/brain-tools"}]}